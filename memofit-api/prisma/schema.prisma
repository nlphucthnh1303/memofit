generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model collections {
  id           Int            @id @default(autoincrement())
  user_id      Int?
  title        String         @db.VarChar(255)
  description  String?
  cover_image  String?        @db.VarChar(255)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  is_delete    String         @default("0") @db.Bit(1)
  users        users?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vocabularies vocabularies[]
}

model exam_questions {
  id          Int        @id @default(autoincrement())
  exam_id     Int?
  question_id Int?
  is_delete   String     @default("0") @db.Bit(1)
  exams       exams?     @relation(fields: [exam_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions   questions? @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model exams {
  id                 Int              @id @default(autoincrement())
  title              String           @db.VarChar(255)
  description        String?
  total_questions    Int?
  time_limit_minutes Int?
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  is_delete          String           @default("0") @db.Bit(1)
  exam_questions     exam_questions[]
  quiz_sessions      quiz_sessions[]
}

model questions {
  id              Int              @id @default(autoincrement())
  vocabulary_id   Int?
  question_type   question_mode
  question_text   String?
  correct_answer  String?
  wrong_answers   Json?
  is_ai_generated Boolean?         @default(false)
  is_approved     Boolean?         @default(true)
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  is_delete       String           @default("0") @db.Bit(1)
  exam_questions  exam_questions[]
  vocabularies    vocabularies?    @relation(fields: [vocabulary_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quiz_results    quiz_results[]
}

model quiz_results {
  id               Int            @id @default(autoincrement())
  session_id       Int?
  vocabulary_id    Int?
  question_id      Int?
  user_answer      String?
  is_correct       Boolean?
  sm2_score        Int?
  response_time_ms Int?
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  is_delete        String         @default("0") @db.Bit(1)
  questions        questions?     @relation(fields: [question_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quiz_sessions    quiz_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vocabularies     vocabularies?  @relation(fields: [vocabulary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([session_id], map: "idx_quiz_results_user")
}

model quiz_sessions {
  id           Int            @id @default(autoincrement())
  user_id      Int?
  mode         session_mode?  @default(normal)
  started_at   DateTime?      @default(now()) @db.Timestamp(6)
  ended_at     DateTime?      @db.Timestamp(6)
  is_delete    String         @default("0") @db.Bit(1)
  quiz_results quiz_results[]
  users        users?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exam_id      Int?
  exams        exams?         @relation(fields: [exam_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([exam_id], map: "idx_quiz_sessions_exam")
}

model user_vocabulary_progress {
  id               Int           @id @default(autoincrement())
  user_id          Int?
  vocabulary_id    Int?
  repetitions      Int?          @default(0)
  interval_days    Int?          @default(0)
  ease_factor      Float?        @default(2.5)
  next_review_date DateTime?     @db.Timestamp(6)
  status           status_type?  @default(learning)
  last_reviewed_at DateTime?     @db.Timestamp(6)
  is_delete        String        @default("0") @db.Bit(1)
  users            users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vocabularies     vocabularies? @relation(fields: [vocabulary_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([next_review_date], map: "idx_user_vocab_progress_next_review")
}

model users {
  id                       Int                        @id @default(autoincrement())
  username                 String                     @unique @db.VarChar(255)
  email                    String                     @unique
  password_hash            String                     @db.VarChar(255)
  current_streak           Int?                       @default(0)
  longest_streak           Int?                       @default(0)
  last_active_date         DateTime?                  @db.Date
  created_at               DateTime?                  @default(now()) @db.Timestamp(6)
  is_delete                String                     @default("0")
  isOtpVerify              Boolean                    @default(false)
  role                     user_role                  @default(USER)
  hearts                   Int?                       @default(5)
  exp_points               Int?                       @default(0)
  collections              collections[]
  password_resets          password_resets[]
  quiz_sessions            quiz_sessions[]
  user_vocabulary_progress user_vocabulary_progress[]
  subscription_orders      subscription_orders[]
  user_path_progress       user_path_progress[]
}

model password_resets {
  id         Int      @id @default(autoincrement())
  otp        String   @db.VarChar(6)
  expires_at DateTime
  created_at DateTime @default(now())
  user_id    Int?
  email      String
  type       String   @default("REGISTER")
  user       users?   @relation(fields: [user_id], references: [id])
}

model vocabularies {
  id                       Int                        @id @default(autoincrement())
  collection_id            Int?
  word                     String                     @db.VarChar(255)
  pos                      String?                    @db.VarChar(50)
  ipa                      String?                    @db.VarChar(100)
  meaning                  String?
  example_sentence         String?
  example_meaning          String?
  created_at               DateTime?                  @default(now()) @db.Timestamp(6)
  is_delete                String                     @default("0") @db.Bit(1)
  questions                questions[]
  quiz_results             quiz_results[]
  user_vocabulary_progress user_vocabulary_progress[]
  collections              collections?               @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([word, pos, collection_id])
  @@index([collection_id], map: "idx_vocab_collection")
}

enum question_mode {
  LISTEN_TYPE_MEANING
  LISTEN_TYPE_WORD
  SEE_WORD_TYPE_MEANING
  SEE_MEANING_TYPE_WORD
  CLOZE_TEST
  MULTIPLE_CHOICE
}

enum session_mode {
  normal
  time_attack
}

enum status_type {
  learning
  mastered
  warning
  expired
}

enum user_role {
  USER
  PRO_USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

model learning_paths {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(255)
  target_band String        @db.VarChar(50)
  description String?
  order_index Int           @default(0)
  is_delete   String        @default("0") @db.Bit(1)
  created_at  DateTime?     @default(now()) @db.Timestamp(6)
  stages      path_stages[]
}

model path_stages {
  id                 Int                  @id @default(autoincrement())
  path_id            Int
  title              String               @db.VarChar(255)
  order_index        Int                  @default(0)
  collection_id      Int?
  video_id           Int?
  exam_id            Int?
  is_delete          String               @default("0") @db.Bit(1)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  path               learning_paths       @relation(fields: [path_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_path_progress user_path_progress[]
}

model user_path_progress {
  id           Int         @id @default(autoincrement())
  user_id      Int
  stage_id     Int
  is_completed Boolean     @default(false)
  score        Int?        @default(0)
  completed_at DateTime?   @db.Timestamp(6)
  users        users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stage        path_stages @relation(fields: [stage_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, stage_id])
}

model interactive_videos {
  id         Int               @id @default(autoincrement())
  title      String            @db.VarChar(255)
  video_url  String            @db.VarChar(500)
  duration_s Int?
  level      String?           @db.VarChar(50)
  category   String?           @db.VarChar(100)
  is_delete  String            @default("0") @db.Bit(1)
  created_at DateTime?         @default(now()) @db.Timestamp(6)
  subtitles  video_subtitles[]
}

model video_subtitles {
  id           Int                @id @default(autoincrement())
  video_id     Int
  start_time_s Float
  end_time_s   Float
  text_en      String
  text_vi      String?
  created_at   DateTime?          @default(now()) @db.Timestamp(6)
  video        interactive_videos @relation(fields: [video_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model subscription_orders {
  id                    Int       @id @default(autoincrement())
  user_id               Int
  order_code            BigInt    @unique
  plan_type             String    @db.VarChar(50)
  amount                Int
  status                String    @default("PENDING") @db.VarChar(50)
  payos_payment_link_id String?   @db.VarChar(255)
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  paid_at               DateTime? @db.Timestamp(6)
  users                 users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

